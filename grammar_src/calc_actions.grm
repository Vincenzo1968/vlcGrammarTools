%{
#include <ctype.h>
#include <math.h>
#define YYSTYPE double
%}

%%
expr : expr '+' term  { $$ = $1 + $3; }
     | expr '-' term  { $$ = $1 - $3; }
     | term           { $$ = $1; }
     ;

term : term '*' fact  { $$ = $1 * $3; }
     | term '/' fact  { $$ = ($3 != 0.0) ? ($1 / $3) : 0.0; }
     | fact           { $$ = $1; }
     ;

fact : '(' expr ')'   { $$ = $2; }
     | NUM            { $$ = $1; }
     ;
%%

static const char *g_input = "5 + 8 * 2 / (4 + 4)";
static size_t g_pos = 0;

int yylex(void)
{
    while (g_input[g_pos] == ' ' || g_input[g_pos] == '\t') g_pos++;
    char c = g_input[g_pos];
    if (c == '\0') return TOK_EOF;
    if (isdigit((unsigned char)c)) {
        char *endp = NULL;
        yylval = strtod(g_input + g_pos, &endp);
        g_pos = (size_t)(endp - g_input);
        return TOK_NUM;
    }
    g_pos++;
    if (c == '+') return TOK_SYM_0;
    if (c == '-') return TOK_SYM_1;
    if (c == '*') return TOK_SYM_2;
    if (c == '/') return TOK_SYM_3;
    if (c == '(') return TOK_SYM_4;
    if (c == ')') return TOK_SYM_5;
    return -1;
}

void yyerror(const char *s) { fprintf(stderr, "Error: %s\n", s); }

int main(void)
{
    YYSTYPE res = 0.0;
    if (ParseLALR1(&res))
        printf("Input: %s => Result = %.2f\n", g_input, res);
    return 0;
}
